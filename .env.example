# URL utilisée par l'application au runtime : rôle applicatif NON-superutilisateur
# (indispensable pour que la Row-Level Security s'applique réellement).
DATABASE_URL="postgresql://rheos_app:rheos_app@localhost:5432/rheos?schema=public"

# URL admin (superutilisateur) : uniquement pour créer le schéma / la RLS.
DATABASE_URL_ADMIN="postgresql://postgres:postgres@localhost:5432/rheos?schema=public"

# Persistance : memory (défaut) ou prisma
STORE="prisma"

# Secret JWT (à changer)
JWT_SECRET="change-me-en-prod"
